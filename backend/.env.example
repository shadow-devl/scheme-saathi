# ------------------------------------------------------------------------------
# AVENIK / SCHEME SAATHI PRODUCTION CONFIGURATION
# ------------------------------------------------------------------------------

# --- DATABASE ---
DATABASE_URL="file:./dev.db" # Replace with your Postgres URL in production: postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# --- SERVER ---
PORT=5000
NODE_ENV="development" # Change to 'production' for live deployments
JWT_SECRET="your_super_secret_jwt_key_here_change_in_production"

# --- EMAIL SYSTEM (GMAIL OAUTH) ---
GMAIL_CLIENT_ID="your-google-cloud-client-id"
GMAIL_CLIENT_SECRET="your-google-cloud-client-secret"
GMAIL_REFRESH_TOKEN="your-google-oauth-refresh-token"
GMAIL_SENDER_EMAIL="support@yourdomain.com" # The email address authorized by the OAuth token

# --- EMAIL SYSTEM (TRANSACTIONAL / SMTP) ---
SMTP_HOST="smtp.sendgrid.net" # or smtp.postmarkapp.com, etc.
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-smtp-api-key"
TRANSACTIONAL_SENDER_EMAIL="notifications@yourdomain.com"

# --- ADMIN SECURE CONSOLE ---
ADMIN_SECRET_KEY="a_secondary_key_for_admin_console_access"
ALLOWED_ADMIN_IPS="127.0.0.1,192.168.1.100" # Comma separated list of IPs (optional)

# --- SECURITY ---
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# --- FRONTEND URL ---
FRONTEND_URL="http://localhost:5173" # Update for production
